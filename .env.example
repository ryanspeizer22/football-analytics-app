# Copy this file to .env and fill in your real keys.

# API-Football key (free tier: https://www.api-football.com/)
FOOTBALL_API_KEY=your-api-football-key-here

# Anthropic API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- Season targeting (optional; defaults suit an API-Football Free plan) ---
# Free covers seasons 2022-2024. After upgrading, raise MAX and set SEASON to
# the campaign you want the UI to open on (e.g. 2025 for the 25/26 season).
PITCHSENSE_MIN_SEASON=2022
PITCHSENSE_MAX_SEASON=2024
# PITCHSENSE_SEASON=2024

# --- Cost protection (optional; these are the defaults) ---
FOOTBALL_API_QUOTA_RESERVE=5    # requests held back from the daily allowance
# Only cache misses — i.e. real model calls — count against these limits.
RATE_LIMIT_PER_CLIENT=8         # new analyses per client per window
RATE_LIMIT_WINDOW_SECONDS=3600  # sliding window length
RATE_LIMIT_DAILY_MAX=150        # hard cap on model calls per UTC day
RATE_LIMIT_MAX_CONCURRENT=3     # parallel generations allowed at once

# --- Deployment (leave unset for local development) ---
# The public origin. Not cosmetic: canonical links, the sitemap and every
# OpenGraph image URL are built from it, and crawlers will not resolve relative
# paths. It also doubles as the switch that disables the loopback rate-limit
# bypass — behind a same-host reverse proxy every request looks local, so
# without this set, production would run with the developer bypass on.
# PITCHSENSE_BASE_URL=https://pitchsense.com

# Which peers may set X-Forwarded-For. NEVER "*": uvicorn rewrites
# request.client from that header for any trusted peer, and the per-client rate
# limit keys on request.client — so "*" lets a caller mint a fresh identity per
# request and bypass the cap on paid generations entirely. Set it to your
# platform's proxy address.
# FORWARDED_ALLOW_IPS=10.0.0.0/8

# Grants founder access (unlimited generations) from a browser that is not on
# the server. Leave unset and token access is disabled outright, which is the
# safe default — a header flag with no secret behind it would let any visitor
# switch off every spend limit. Use a long random value and rotate it like any
# other secret.
# ADMIN_TOKEN=

# Forces the loopback bypass on or off regardless of the base URL. Only useful
# for testing the production path locally.
# RATE_LIMIT_BYPASS_LOCAL=0

# --- Optional integrations ---
# YouTube Data API v3 key. Without it the highlights resolver is inert and only
# the hand-verified video ids in services/highlights_data.json are used; nothing
# breaks. With it, official highlights are resolved automatically per fixture.
# YOUTUBE_API_KEY=
