# Copy this file to .env and fill in your real keys.

# API-Football key (free tier: https://www.api-football.com/)
FOOTBALL_API_KEY=your-api-football-key-here

# Anthropic API key (https://platform.claude.com/)
ANTHROPIC_API_KEY=your-anthropic-key-here

# --- Season targeting (optional; defaults suit an API-Football Free plan) ---
# Free covers seasons 2022-2024. After upgrading, raise MAX and set SEASON to
# the campaign you want the UI to open on (e.g. 2025 for the 25/26 season).
PITCHSENSE_MIN_SEASON=2022
PITCHSENSE_MAX_SEASON=2024
# PITCHSENSE_SEASON=2024

# --- Cost protection (optional; these are the defaults) ---
FOOTBALL_API_QUOTA_RESERVE=5    # requests held back from the daily allowance
# Only cache misses — i.e. real model calls — count against these limits.
RATE_LIMIT_PER_CLIENT=8         # new analyses per client per window
RATE_LIMIT_WINDOW_SECONDS=3600  # sliding window length
RATE_LIMIT_DAILY_MAX=150        # hard cap on model calls per UTC day
RATE_LIMIT_MAX_CONCURRENT=3     # parallel generations allowed at once
